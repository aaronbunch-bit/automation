/** Independent targeted simulation scheduler. No year-round triggers or messaging. */
const CS = {ID:'1riFYw9LiAnrtmvuLaKvRZXuqO57DXCJP0ihiyZvLLv8',TZ:'America/Chicago',BASE:'https://api.assembledhq.com/v0',STEP:1800,QUEUES:{'Adult Learning':'Adult Learner_CC90_New','College':'College and Grad TP_CC90_New','ELD':'Elementary and LD_CC90_New','High School':'High School_CC90_New','Prof Certs':'Prof Certs_CC90_New'}};
function onOpen(){SpreadsheetApp.getUi().createMenu('Targeted Sims').addItem('Check roster / connection','checkCampaignRoster').addItem('Preview selected campaign','previewCampaign').addItem('Publish preview to Assembled','publishCampaign').addSeparator().addItem('Run scheduler self-tests','runSchedulerTests').addToUi();}
function csBook_(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss||ss.getId()!==CS.ID)throw Error('Open the independent Canada scheduler workbook.');return ss;}
function csSheet_(name){const s=csBook_().getSheetByName(name);if(!s)throw Error('Missing tab: '+name);return s;}
function csRows_(name){return csSheet_(name).getDataRange().getValues();}
function csText_(v){return String(v==null?'':v).trim();}
function csNorm_(v){return csText_(v).toLowerCase().replace(/\s+/g,' ');}
function csEnabled_(v){return v===true||csNorm_(v)==='true';}
function csSettings_(){const c={};csRows_('Settings').slice(1).forEach(r=>c[csText_(r[0])]=r[1]);if(c.TIME_ZONE!==CS.TZ)throw Error('TIME_ZONE must remain America/Chicago.');return c;}
function csDate_(v){return v instanceof Date?Utilities.formatDate(v,CS.TZ,'yyyy-MM-dd'):csText_(v);}
function csEpoch_(date,time){return Utilities.parseDate(date+' '+time,CS.TZ,'yyyy-MM-dd HH:mm').getTime()/1000;}
function csStamp_(epoch){return Utilities.formatDate(new Date(epoch*1000),CS.TZ,'yyyy-MM-dd HH:mm');}
function csHash_(text){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,text).map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join('');}
function csMarker_(campaign,email){return '[TSIM:'+csHash_(campaign+'|'+csNorm_(email)).slice(0,24)+']';}
function csCampaign_(requireDates){const settings=csSettings_();const id=csText_(settings.ACTIVE_CAMPAIGN_ID);const matches=csRows_('Campaigns').slice(1).filter(r=>csText_(r[0])===id);if(matches.length!==1)throw Error('Choose one unique ACTIVE_CAMPAIGN_ID in Settings.');const r=matches[0];if(!csEnabled_(r[7]))throw Error('Campaign is not enabled.');const c={id:id,label:csText_(r[1]),sim:csText_(r[2]),first:csDate_(r[3]),last:csDate_(r[4]),minutes:Number(r[5]),cap:Number(r[6]),settings:settings};if(!c.label)throw Error('Campaign label is required.');if(c.minutes!==30||c.cap!==2)throw Error('This scheduler requires 30 minutes and a maximum of 2 simultaneous reps per supergroup.');if(requireDates){if(!c.sim)throw Error('Enter the exact simulation name in Campaigns.');if(!/^\d{4}-\d{2}-\d{2}$/.test(c.first)||!/^\d{4}-\d{2}-\d{2}$/.test(c.last))throw Error('Enter start/end dates as YYYY-MM-DD.');c.start=csEpoch_(c.first,'00:00');c.end=csEpoch_(csNextDate_(c.last),'00:00');if(csStamp_(c.start).slice(0,10)!==c.first||c.end<=c.start||c.end-c.start>Number(settings.MAX_SEARCH_DAYS||14)*90000)throw Error('Invalid dates or campaign exceeds MAX_SEARCH_DAYS.');if(c.end<=Date.now()/1000)throw Error('Campaign end date is in the past.');}return c;}
function csNextDate_(s){const d=new Date(s+'T12:00:00Z');d.setUTCDate(d.getUTCDate()+1);return d.toISOString().slice(0,10);}
// Hash the persisted preview after Sheets has normalized dates and numeric values.
function csPreviewRows_(){return csRows_('Preview').slice(1).filter(r=>r[0]);}
function csPreviewHash_(){return csHash_(JSON.stringify(csPreviewRows_()));}
function csFingerprint_(){const names=['Campaigns','Roster','Settings'].concat(csCsvTabs_());return csHash_(JSON.stringify(names.map(name=>[name,csRows_(name)])));}
function csCsvTabs_(group){const groups=group?[group]:Object.keys(CS.QUEUES);return csBook_().getSheets().map(s=>s.getName()).filter(name=>groups.some(g=>name==='ReflexAI CSV - '+g||name.startsWith('ReflexAI CSV - '+g+' - '))).sort();}
function csHeaders_(){const key=csText_(csRows_('Connection').find(r=>r[0]==='ASSEMBLED_API_KEY')?.[1]);if(!key)throw Error('Assembled API key is missing from Connection.');return {Authorization:'Basic '+Utilities.base64Encode(key+':'),'Content-Type':'application/json'};}
// Retry only read requests; booking writes are never automatically retried.
let csLastReadAt_=0;
function csRetryDelay_(headers,attempt){const key=Object.keys(headers||{}).find(k=>k.toLowerCase()==='retry-after');const raw=key?String(headers[key]):'';let delay=raw!==''&&Number.isFinite(Number(raw))?Number(raw)*1000:Date.parse(raw)-Date.now();if(!Number.isFinite(delay))delay=0;return Math.max(2000*Math.pow(2,attempt),delay);}
function csGet_(path,params){const qs=Object.keys(params||{}).map(k=>encodeURIComponent(k)+'='+encodeURIComponent(params[k])).join('&');for(let attempt=0;attempt<4;attempt++){const pause=500-(Date.now()-csLastReadAt_);if(pause>0)Utilities.sleep(pause);csLastReadAt_=Date.now();const r=UrlFetchApp.fetch(CS.BASE+path+(qs?'?'+qs:''),{method:'get',headers:csHeaders_(),muteHttpExceptions:true});const status=r.getResponseCode();if(status>=200&&status<300)return JSON.parse(r.getContentText()||'{}');if(status===429){const delay=csRetryDelay_(r.getAllHeaders(),attempt);if(attempt<3&&delay<=30000){Utilities.sleep(delay);continue;}throw Error('Assembled is temporarily rate-limiting requests. Existing bookings are saved. Wait a few minutes, then generate a fresh preview for remaining reps.');}throw Error('Assembled read failed: '+path+' (HTTP '+status+').');}}
// Reuse group/day forecasts for at most 60 seconds during this publish run.
function csPublishForecast_(cache,c,ctx,group,date,accepted){const key=group+'|'+date;let entry=cache[key];if(!entry||Date.now()-entry.at>60000){entry={forecast:csForecast_(Object.assign({},c,{first:date,last:date}),ctx,group),at:Date.now(),acceptedCount:accepted.length};cache[key]=entry;}return {forecast:entry.forecast,reserved:accepted.slice(entry.acceptedCount).filter(a=>a.group===group)};}

function csList_(raw){if(Array.isArray(raw))return raw;return Object.keys(raw||{}).map(id=>Object.assign({id:id},raw[id]));}
function csPeople_(){let out=[];for(let offset=0;offset<10000;){const r=csGet_('/people',{limit:100,offset:offset});const page=csList_(r.people);out=out.concat(page);if(page.length<100||(Number(r.total)>0&&out.length>=Number(r.total)))return out;offset+=page.length;}throw Error('People pagination exceeded safety limit.');}
function csGroupIds_(p,queueIds){let raw=p.queues||p.queue_ids||[];let ids=Array.isArray(raw)?raw.map(x=>typeof x==='object'?x.id||x.queue_id:x):Object.keys(raw);return Object.keys(queueIds).filter(g=>ids.indexOf(queueIds[g])>=0);}
function csContext_(c){const queues=csList_(csGet_('/queues',{}).queues);const queueIds={};Object.keys(CS.QUEUES).forEach(g=>{const q=queues.filter(q=>csNorm_(q.name)===csNorm_(CS.QUEUES[g]));if(q.length===1)queueIds[g]=q[0].id;});const sites=csList_(csGet_('/sites',{}).sites).filter(s=>csNorm_(s.name)===csNorm_(c.settings.SITE_NAME));if(sites.length!==1)throw Error('Cannot resolve Consumer Sales site uniquely.');const types=csList_(csGet_('/activity_types',{}).activity_types);const training=types.filter(t=>csNorm_(t.name)==='training');if(training.length!==1)throw Error('Cannot resolve Training activity type uniquely.');const typeMap={};types.forEach(t=>typeMap[t.id]=t);const people=csPeople_();const peopleMap={};people.forEach(p=>{const id=p.agent_id||p.id;if(id)peopleMap[id]=Object.assign({},p,{agentId:id,groups:csGroupIds_(p,queueIds)});});return {queueIds:queueIds,siteId:sites[0].id,types:typeMap,trainingId:training[0].id,people:people,peopleMap:peopleMap};}
function csResolveRoster_(c,ctx){const good=[],errors=[],seen={};const rows=csRows_('Roster').slice(1);rows.forEach((r,i)=>{if(csText_(r[0])!==c.id||!csEnabled_(r[5]))return;const name=csText_(r[1]),email=csNorm_(r[2]),group=csText_(r[3]);const match=ctx.people.filter(p=>email?csNorm_(p.email)===email:csNorm_(p.name||[p.first_name,p.last_name].filter(Boolean).join(' '))===csNorm_(name));if(match.length!==1){errors.push([c.id,name,email,'No unique Assembled identity; enter the verified email.',new Date()]);return;}const p=match[0],e=csNorm_(p.email),agentId=p.agent_id||p.id;const groups=csGroupIds_(p,ctx.queueIds);const g=group||(groups.length===1?groups[0]:'');if(!e||!agentId||seen[e]){errors.push([c.id,name,e,'Missing email/agent ID or duplicate enabled roster entry.',new Date()]);return;}seen[e]=true;if(!ctx.queueIds[g]||(groups.length&&groups.indexOf(g)<0)){errors.push([c.id,name,e,'Confirm current supergroup in Roster; source and Assembled may differ.',new Date()]);return;}if(!groups.length&&ctx.peopleMap[agentId])ctx.peopleMap[agentId].groups=[g];good.push({name:name,email:e,group:g,agentId:agentId,manager:csText_(r[4]),row:i+2});});if(!rows.some(r=>csText_(r[0])===c.id&&csEnabled_(r[5])))throw Error('No enabled roster rows for this campaign.');return {good:good,errors:errors};}
function csCsvNeeds_(c,reps){
  const good=[],errors=[],byGroup={};
  [...new Set(reps.map(r=>r.group))].forEach(group=>{
    const records=[];let problem='';
    const tabs=csCsvTabs_(group);
    if(!tabs.length)problem='Missing CSV tab for '+group+'.';
    tabs.forEach(name=>{
      const values=csRows_(name);
      if(values.length<2)return;
      const h=values[0].map(csNorm_);
      function col(names){const hits=h.map((v,i)=>names.indexOf(v)>=0?i:-1).filter(i=>i>=0);if(hits.length!==1)throw Error(name+' requires one column: '+names[0]);return hits[0];}
      try{
        const e=col(['user email','email']),s=col(['simulation name','simulation','sim']),st=col(['status']);
        values.slice(1).forEach(row=>{
          if(row.every(v=>csText_(v)===''))return;
          // Allow multiple CSV exports to be stacked, including repeated headers.
          if(csNorm_(row[e])===h[e]&&csNorm_(row[s])===h[s]&&csNorm_(row[st])===h[st])return;
          records.push({email:csNorm_(row[e]),sim:csNorm_(row[s]),status:csNorm_(row[st])});
        });
      }catch(err){problem=err.message;}
    });
    byGroup[group]={records:records,problem:problem};
  });
  reps.forEach(rep=>{
    const bucket=byGroup[rep.group];
    if(bucket.problem){errors.push([c.id,rep.name,rep.email,bucket.problem+' No assignment made for this supergroup.',new Date()]);return;}
    const statuses=bucket.records.filter(r=>r.email===rep.email&&r.sim===csNorm_(c.sim)).map(r=>r.status);
    if(statuses.some(x=>['completed','complete','passed'].indexOf(x)>=0)){errors.push([c.id,rep.name,rep.email,'Already completed in supergroup CSV — skipped.',new Date()]);return;}
    if(!statuses.length||statuses.some(x=>['not started','incomplete'].indexOf(x)<0)){errors.push([c.id,rep.name,rep.email,'Missing simulation row or unrecognized status in '+rep.group+' CSVs — not assigned.',new Date()]);return;}
    good.push(rep);
  });
  return {good:good,errors:errors};
}
function csWrite_(name,rows){const sh=csSheet_(name);if(sh.getLastRow()>1)sh.getRange(2,1,sh.getLastRow()-1,sh.getLastColumn()).clearContent();if(rows.length){if(sh.getMaxRows()<rows.length+1)sh.insertRowsAfter(sh.getMaxRows(),rows.length+1-sh.getMaxRows());sh.getRange(2,1,rows.length,rows[0].length).setValues(rows);}}
function csStatus_(message){csSheet_('Start Here').getRange('B2').setValue(message);}
function checkCampaignRoster(){const c=csCampaign_(false),ctx=csContext_(c),r=csResolveRoster_(c,ctx);r.good.forEach(p=>csSheet_('Roster').getRange(p.row,3,1,2).setValues([[p.email,p.group]]));csWrite_('Exceptions',r.errors);csStatus_('Connection checked. '+r.good.length+' roster matches; '+r.errors.length+' require attention.');SpreadsheetApp.getUi().alert('Matched '+r.good.length+' reps. Review Exceptions for '+r.errors.length+' unresolved entries. No bookings made.');}
function csActivities_(c){const r=csGet_('/activities',{start_time:Math.floor(c.start),end_time:Math.floor(c.end),include_agents:true,include_activity_types:true});return csList_(r.activities).map(a=>Object.assign({},a,{start:Number(a.start_time),end:Number(a.end_time)}));}
function csIsWork_(a,ctx,c){const t=ctx.types[a.type_id]||{};const n=csNorm_(t.name);const names=csText_(c.settings.WORK_ACTIVITY_NAMES).split(',').map(csNorm_);return !t.timeoff&&(names.indexOf(n)>=0||(t.productive===true&&/(phone|chat|sms)/.test(n)));}
function csOverlap_(a,b){return a.start<b.end&&b.start<a.end;}
function csCovered_(work,blocked,start,end){const w={start:start,end:end};if(blocked.some(b=>csOverlap_(b,w)))return false;let cursor=start;const spans=work.filter(a=>csOverlap_(a,w)).sort((a,b)=>a.start-b.start);for(const a of spans){if(a.start>cursor)return false;cursor=Math.max(cursor,a.end);if(cursor>=end)return true;}return false;}
function csPeak_(spans,start,end){const events=[];spans.forEach(a=>{if(a.start<end&&a.end>start){events.push([Math.max(start,a.start),1]);events.push([Math.min(end,a.end),-1]);}});events.sort((a,b)=>a[0]-b[0]||a[1]-b[1]);let n=0,max=0;events.forEach(e=>{n+=e[1];max=Math.max(max,n);});return max;}
function csOccupancy_(activities,ctx){const spans=[];activities.filter(a=>a.type_id===ctx.trainingId).forEach(a=>{const p=ctx.peopleMap[a.agent_id];(p?.groups||[]).forEach(g=>spans.push({start:a.start,end:a.end,group:g,agentId:a.agent_id,id:a.id,marker:csText_(a.description)}));});return spans;}
function csForecast_(c,ctx,group){const all=[];for(let date=c.first;date<=c.last;date=csNextDate_(date)){const a=csEpoch_(date,'00:00'),b=csEpoch_(csNextDate_(date),'00:00');for(let offset=0;offset<500;){const r=csGet_('/forecasted_vs_actuals',{start_time:a,end_time:b,channel:'phone',interval:CS.STEP,site:ctx.siteId,queue:ctx.queueIds[group],limit:100,offset:offset});const page=r.forecasts_vs_actuals||r.forecasted_vs_actuals||[];if(!Array.isArray(page))throw Error('Unexpected forecast response.');all.push.apply(all,page);if(page.length<100)break;offset+=page.length;if(offset>=500)throw Error('Forecast pagination incomplete.');}}const byStart={};all.forEach(a=>{const scheduled=a.staffing_scheduled,required=a.staffing_required?.forecasted;const net=a.staffing_net==null||a.staffing_net===''?(scheduled!=null&&required!=null?Number(scheduled)-Number(required):NaN):Number(a.staffing_net);if(Number.isFinite(net)&&Number(a.start_time)>0)byStart[Number(a.start_time)]={start:Number(a.start_time),end:Number(a.start_time)+CS.STEP,net:net};});return Object.values(byStart).sort((a,b)=>a.start-b.start);}
function csScore_(forecast,start,end,reserved){let cursor=start,score=Infinity;for(const f of forecast){if(f.end<=cursor||f.start>=end)continue;if(f.start>cursor)return null;score=Math.min(score,f.net-1-csPeak_(reserved,Math.max(start,f.start),Math.min(end,f.end)));cursor=Math.max(cursor,Math.min(end,f.end));if(cursor>=end)return score;}return null;}
function csBest_(forecast,work,blocked,occupied,reserved,c,now){let best=null;const floor=csText_(c.settings.MIN_POST_NET)===''?-Infinity:Number(c.settings.MIN_POST_NET);if(Number.isNaN(floor))throw Error('MIN_POST_NET must be blank or numeric.');const notice=Number(c.settings.MIN_NOTICE_HOURS),minHour=Number(c.settings.BUSINESS_HOUR_START),maxHour=Number(c.settings.BUSINESS_HOUR_END);if(!Number.isFinite(notice)||notice<0||!(minHour>=0&&maxHour<=24&&maxHour>minHour))throw Error('Invalid scheduling hours.');for(const f of forecast){const start=f.start,end=start+c.minutes*60;if(start<c.start||end>c.end||start<now+notice*3600)continue;const date=Utilities.formatDate(new Date(start*1000),CS.TZ,'yyyy-MM-dd');const dayStart=csEpoch_(date,String(minHour).padStart(2,'0')+':00'),dayEnd=maxHour===24?csEpoch_(csNextDate_(date),'00:00'):csEpoch_(date,String(maxHour).padStart(2,'0')+':00');if(start<dayStart||end>dayEnd)continue;if(!csCovered_(work,blocked,start,end)||csPeak_(occupied.concat(reserved),start,end)>=c.cap)continue;const score=csScore_(forecast,start,end,reserved);if(score===null||score<floor)continue;if(!best||score>best.score||(score===best.score&&start<best.start))best={start:start,end:end,score:score};}return best;}
function csLedger_(){return csRows_('Bookings').slice(1).filter(r=>r[0]);}
function csReconcile_(c,rep,activities,ledger){const marker=csMarker_(c.id,rep.email);const remote=activities.filter(a=>a.agent_id===rep.agentId&&csText_(a.description).indexOf(marker)>=0);const rows=ledger.filter(r=>csText_(r[0])===c.id&&csNorm_(r[2])===rep.email);if(remote.length){const a=remote[0];const row=[c.id,rep.name,rep.email,rep.group,c.sim,csStamp_(a.start),csStamp_(a.end),a.id||'', 'BOOKED',new Date(),marker,a.start,a.end,rep.agentId];const found=csRows_('Bookings').findIndex((r,i)=>i>0&&r[0]===c.id&&csNorm_(r[2])===rep.email);if(found>0)csSheet_('Bookings').getRange(found+1,1,1,14).setValues([row]);else csSheet_('Bookings').appendRow(row);return 'Already booked in Assembled.';}if(rows.length)return rows.some(r=>r[8]==='BOOKED')?'Already booked for this campaign.':'Previous write pending/uncertain. Review Assembled and booking history before retrying.';return '';}
function previewCampaign(){const lock=LockService.getDocumentLock();lock.waitLock(10000);try{const c=csCampaign_(true),ctx=csContext_(c),roster=csResolveRoster_(c,ctx),csv=csCsvNeeds_(c,roster.good);let errors=roster.errors.concat(csv.errors);const activities=csActivities_(c),ledger=csLedger_(),occupied=csOccupancy_(activities,ctx),forecasts={},reservations={},rows=[];const fingerprint=csFingerprint_();const reps=csv.good.filter(rep=>{const reason=csReconcile_(c,rep,activities,ledger);if(reason)errors.push([c.id,rep.name,rep.email,reason,new Date()]);return !reason;});reps.forEach(p=>{if(!forecasts[p.group])forecasts[p.group]=csForecast_(c,ctx,p.group);});const now=Date.now()/1000;const candidates=reps.map(rep=>{const acts=activities.filter(a=>a.agent_id===rep.agentId),work=acts.filter(a=>csIsWork_(a,ctx,c)),blocked=acts.filter(a=>!csIsWork_(a,ctx,c));return {rep:rep,work:work,blocked:blocked,count:forecasts[rep.group].filter(f=>csCovered_(work,blocked,f.start,f.start+1800)).length};}).sort((a,b)=>a.count-b.count||a.rep.email.localeCompare(b.rep.email));candidates.forEach(x=>{const p=x.rep,g=p.group;const reserved=reservations[g]||(reservations[g]=[]);const best=csBest_(forecasts[g],x.work,x.blocked,occupied.filter(a=>a.group===g),reserved,c,now);if(!best){errors.push([c.id,p.name,p.email,'No full 30-minute working window satisfies the overlap limit and configured coverage floor.',new Date()]);return;}reserved.push(best);rows.push([c.id,p.name,p.email,g,c.sim,csStamp_(best.start),csStamp_(best.end),best.score,'READY',best.score<0?'Best available; supergroup coverage remains below forecast.':'',p.agentId,best.start,best.end,fingerprint]);});csWrite_('Preview',rows);csWrite_('Exceptions',errors);SpreadsheetApp.flush();PropertiesService.getScriptProperties().setProperties({PREVIEW_FINGERPRINT:fingerprint,PREVIEW_CREATED:String(Date.now()),PREVIEW_PLAN_HASH:csPreviewHash_()});csStatus_('Preview ready: '+rows.length+' sessions; '+errors.length+' exceptions/skips. No bookings made.');SpreadsheetApp.getUi().alert('Preview contains '+rows.length+' sessions. Review Preview and Exceptions, then publish.');}finally{lock.releaseLock();}}
function publishCampaign(){const ui=SpreadsheetApp.getUi();if(ui.alert('Publish training','Book the READY sessions shown in Preview in Assembled? Live shifts and overlap limits will be checked again.',ui.ButtonSet.YES_NO)!==ui.Button.YES)return;csPublish_();}
function csPublish_(){const lock=LockService.getDocumentLock();lock.waitLock(10000);try{const started=Date.now(),c=csCampaign_(true),props=PropertiesService.getScriptProperties(),fp=csFingerprint_();if(props.getProperty('PREVIEW_FINGERPRINT')!==fp)throw Error('Inputs changed. Generate a new preview.');if(Date.now()-Number(props.getProperty('PREVIEW_CREATED'))>Number(c.settings.PREVIEW_MAX_AGE_MINUTES||60)*60000)throw Error('Preview expired. Generate a new preview.');const preview=csPreviewRows_();if(csHash_(JSON.stringify(preview))!==props.getProperty('PREVIEW_PLAN_HASH'))throw Error('Preview was edited. Generate a new preview.');const ctx=csContext_(c),roster=csResolveRoster_(c,ctx),csv=csCsvNeeds_(c,roster.good);const reps={};csv.good.forEach(p=>reps[p.email]=p);let booked=0,held=0;const accepted=[],forecastCache={};for(let i=0;i<preview.length;i++){if(Date.now()-started>240000){csStatus_('Publish paused at runtime limit. Generate a fresh preview to continue; existing bookings will be skipped.');break;}const row=preview[i],rep=reps[csNorm_(row[2])];const setStatus=(s,n)=>csSheet_('Preview').getRange(i+2,9,1,2).setValues([[s,n]]);if(!rep||row[0]!==c.id||row[3]!==rep.group||row[4]!==c.sim||row[10]!==rep.agentId){setStatus('HELD','Roster or simulation mismatch.');held++;continue;}const start=Number(row[11]),end=Number(row[12]);if(!Number.isFinite(start)||end-start!==1800||start<c.start||end>c.end||start<Date.now()/1000+Number(c.settings.MIN_NOTICE_HOURS)*3600){setStatus('HELD','Invalid or too-soon session. Generate a new preview.');held++;continue;}const activities=csActivities_(c),ledger=csLedger_();const reason=csReconcile_(c,rep,activities,ledger);if(reason){setStatus('SKIPPED',reason);continue;}const acts=activities.filter(a=>a.agent_id===rep.agentId);const occupied=csOccupancy_(activities,ctx).filter(a=>a.group===rep.group);accepted.filter(a=>a.group===rep.group&&!occupied.some(o=>o.id===a.id)).forEach(a=>occupied.push(a));if(!csCovered_(acts.filter(a=>csIsWork_(a,ctx,c)),acts.filter(a=>!csIsWork_(a,ctx,c)),start,end)||csPeak_(occupied,start,end)>=c.cap){setStatus('HELD','Live shift or two-person overlap check failed. Generate a new preview.');held++;continue;}const fc=csPublishForecast_(forecastCache,c,ctx,rep.group,csStamp_(start).slice(0,10),accepted);const score=csScore_(fc.forecast,start,end,fc.reserved);const floor=csText_(c.settings.MIN_POST_NET)===''?-Infinity:Number(c.settings.MIN_POST_NET);if(score===null||score<floor){setStatus('HELD','Coverage changed or missing. Generate a new preview.');held++;continue;}const marker=csMarker_(c.id,rep.email);const sh=csSheet_('Bookings');sh.appendRow([c.id,rep.name,rep.email,rep.group,c.sim,csStamp_(start),csStamp_(end),'','PENDING',new Date(),marker,start,end,rep.agentId]);const lr=sh.getLastRow();SpreadsheetApp.flush();try{const body=ReflexCapacity.commitReflexActivity(csHeaders_(),{agent_id:rep.agentId,type_id:ctx.trainingId,start_time:start,end_time:end,allow_conflicts:false,description:'[Mandatory] '+c.label+' — '+c.sim+' '+marker},rep.group,c.cap),id=body.id||body.activity?.id;if(!id)throw Error('No activity ID returned.');sh.getRange(lr,8,1,3).setValues([[id,'BOOKED',new Date()]]);SpreadsheetApp.flush();accepted.push({start:start,end:end,group:rep.group,id:id});setStatus('BOOKED','Assembled activity '+id);booked++;}catch(error){sh.getRange(lr,9,1,2).setValues([['UNCERTAIN',new Date()]]);setStatus('HELD','Write not confirmed. Check Assembled; do not retry blindly.');csStatus_('Publish stopped after an uncertain write. Check booking history and Assembled.');held++;break;}}props.deleteProperty('PREVIEW_PLAN_HASH');csStatus_('Publish result: '+booked+' booked, '+held+' held. Generate a fresh preview for remaining reps.');uiSafe_('Booked '+booked+' sessions; '+held+' held. See Preview and Bookings.');}finally{lock.releaseLock();}}
function uiSafe_(s){SpreadsheetApp.getUi().alert(s);}
function runSchedulerTests(){const results=csTests_();Logger.log(results.join('\n'));uiSafe_(results.length+' scheduler tests passed. No external calls or bookings.');}
function csTests_(){const passed=[];function test(name,condition){if(!condition)throw Error('FAILED: '+name);passed.push(name);}test('Partial shift rejected',!csCovered_([{start:0,end:900}],[],0,1800));test('Adjacent work spans cover session',csCovered_([{start:0,end:900},{start:900,end:1800}],[],0,1800));test('Break rejected',!csCovered_([{start:0,end:1800}],[{start:600,end:900}],0,1800));test('Gap rejected',!csCovered_([{start:0,end:800},{start:900,end:1800}],[],0,1800));test('Two overlapping sessions count',csPeak_([{start:0,end:1800},{start:900,end:2700}],1200,3000)===2);test('Back-to-back does not overlap',csPeak_([{start:0,end:1800}],1800,3600)===0);test('Nonoverlapping reservations peak one',csPeak_([{start:0,end:900},{start:900,end:1800}],0,1800)===1);test('Coverage accounts for reservations',csScore_([{start:0,end:1800,net:4}],0,1800,[{start:0,end:1800}])===2);test('Missing forecast rejected',csScore_([{start:0,end:900,net:4}],0,1800,[])===null);test('Lowest coverage controls score',csScore_([{start:0,end:900,net:4},{start:900,end:1800,net:1}],0,1800,[])===0);return passed;}

/** Safe link check: invalid input must be rejected before any read or booking. */
function verifySharedReflexCapacity() {
  try {
    ReflexCapacity.commitReflexActivity({}, {start_time: 0, end_time: 0}, 'High School', 3);
    throw Error('Shared capacity validation unexpectedly accepted invalid input');
  } catch (error) {
    if (String(error).indexOf('Invalid ReflexAI booking interval') < 0) throw error;
    Logger.log('Shared ReflexAI capacity library v11 verified. Invalid input rejected; no booking or message created.');
  }
}
