# --- Mode ---
# Set to "demo" to use fixture data (no external credentials required)
PGC_MODE=live

# --- Google Sheets (coaching events source + optional writeback) ---
GOOGLE_SHEETS_SPREADSHEET_ID=1ClH8uYgfiKMjPJ1-ooFj3bsTel1r6vHSZ3focyjLe0A
GOOGLE_SHEETS_TAB=Coaching
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Header names on the coaching sheet (case-insensitive match)
SHEET_COL_COACHEE=Coachee
SHEET_COL_COACHEE_EMAIL=Coachee Email
SHEET_COL_COACH=Coach
SHEET_COL_COACHING_DATE=Coaching Date
SHEET_COL_L7=pGC L7
SHEET_COL_N7=pGC N7
SHEET_COL_DELTA=pGC Delta
SHEET_COL_VERDICT=Verdict
SHEET_COL_SCORED_AT=Scored At

# Write scored columns back to the sheet after sync
SHEET_WRITEBACK=true

# --- Looker (pGC time series) ---
LOOKER_BASE_URL=https://your-instance.looker.com
LOOKER_CLIENT_ID=
LOOKER_CLIENT_SECRET=

# Inline query against a LookML explore
LOOKER_MODEL=
LOOKER_EXPLORE=
LOOKER_PERSON_FIELD=user.email
LOOKER_DATE_FIELD=performance.date
LOOKER_PGC_FIELD=performance.pgc

# Optional: run an existing Look by ID instead of an inline query
# LOOKER_LOOK_ID=

# --- Bank storage (Netlify Blobs store name; falls back to local data/results.json) ---
PGC_BLOB_STORE=pgc-coaching-bank
